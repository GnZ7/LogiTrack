@LogiTrack_HostAddress = https://localhost:7123

# See the repository README for local authentication setup with User Secrets.

###

### Register an operator account
POST {{LogiTrack_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "operator@example.com",
  "password": "ChangeMe123!"
}

### Log in and copy the returned accessToken for the API requests below
# @name login
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "operator@example.com",
  "password": "ChangeMe123!"
}

### Create inventory for order examples
# @name createInventoryItem
POST {{LogiTrack_HostAddress}}/api/items
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "name": "Packing boxes",
  "quantity": 10,
  "location": "Warehouse A"
}

### Create an order
# @name createOrder
POST {{LogiTrack_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Acme Logistics",
  "items": [
    {
      "itemId": "{{createInventoryItem.response.body.$.itemId}}",
      "quantity": 2
    }
  ]
}

### Get the created order
GET {{LogiTrack_HostAddress}}/api/orders/{{createOrder.response.body.$.orderId}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

### Get a non-existent order
GET {{LogiTrack_HostAddress}}/api/orders/00000000-0000-0000-0000-000000000000
Accept: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

### Try to order more than the remaining inventory
POST {{LogiTrack_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Acme Logistics",
  "items": [
    {
      "itemId": "{{createInventoryItem.response.body.$.itemId}}",
      "quantity": 100
    }
  ]
}

### Try to order an item that does not exist
POST {{LogiTrack_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Acme Logistics",
  "items": [
    {
      "itemId": "00000000-0000-0000-0000-000000000000",
      "quantity": 1
    }
  ]
}

### Delete the created order
# This returns 403 for an operator; use a configured Administrator token to delete.
DELETE {{LogiTrack_HostAddress}}/api/orders/{{createOrder.response.body.$.orderId}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Delete a non-existent order
DELETE {{LogiTrack_HostAddress}}/api/orders/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{login.response.body.$.accessToken}}