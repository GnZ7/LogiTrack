@LogiTrack_HostAddress = https://localhost:7123

# See the repository README for setup and instructions for running these requests.
# Start the API with: dotnet run --launch-profile https

###

### Register an operator account (send once; use a new email if it already exists)
POST {{LogiTrack_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "operator@example.com",
  "password": "ChangeMe123!"
}

### Log in as the operator; protected requests use this response's token
# @name login
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "operator@example.com",
  "password": "ChangeMe123!"
}

### Create inventory for the order examples
# @name createInventoryItem
POST {{LogiTrack_HostAddress}}/api/items
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "name": "Packing boxes",
  "quantity": 10,
  "location": "Warehouse A"
}

### List inventory (send twice within 30 seconds to observe a cache hit in API logs)
GET {{LogiTrack_HostAddress}}/api/items?pageNumber=1&pageSize=10
Accept: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

### Get the created inventory item
GET {{LogiTrack_HostAddress}}/api/items/{{createInventoryItem.response.body.$.itemId}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

### Update the created inventory item
# @name updateInventoryItem
PUT {{LogiTrack_HostAddress}}/api/items/{{createInventoryItem.response.body.$.itemId}}
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "name": "Packing boxes",
  "quantity": 12,
  "location": "Warehouse B"
}

### Update a non-existent inventory item (expect 404)
PUT {{LogiTrack_HostAddress}}/api/items/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "name": "Missing item",
  "quantity": 1,
  "location": "Warehouse A"
}

### Create an order
# @name createOrder
POST {{LogiTrack_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Acme Logistics",
  "items": [
    {
      "itemId": "{{createInventoryItem.response.body.$.itemId}}",
      "quantity": 2
    }
  ]
}

### Try to update the order beyond available stock (expect 409; original order remains unchanged)
PUT {{LogiTrack_HostAddress}}/api/orders/{{createOrder.response.body.$.orderId}}
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Acme Logistics",
  "items": [
    {
      "itemId": "{{createInventoryItem.response.body.$.itemId}}",
      "quantity": 100
    }
  ]
}

### Update the order and replace its item reservation
# @name updateOrder
PUT {{LogiTrack_HostAddress}}/api/orders/{{createOrder.response.body.$.orderId}}
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Acme Logistics - updated",
  "items": [
    {
      "itemId": "{{createInventoryItem.response.body.$.itemId}}",
      "quantity": 3
    }
  ]
}

### Update a non-existent order (expect 404)
PUT {{LogiTrack_HostAddress}}/api/orders/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Missing order",
  "items": [
    {
      "itemId": "{{createInventoryItem.response.body.$.itemId}}",
      "quantity": 1
    }
  ]
}

### Get the updated order
GET {{LogiTrack_HostAddress}}/api/orders/{{createOrder.response.body.$.orderId}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

### Get a non-existent order (expect 404)
GET {{LogiTrack_HostAddress}}/api/orders/00000000-0000-0000-0000-000000000000
Accept: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

### Try to order more than the remaining inventory (expect 409)
POST {{LogiTrack_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Acme Logistics",
  "items": [
    {
      "itemId": "{{createInventoryItem.response.body.$.itemId}}",
      "quantity": 100
    }
  ]
}

### Try to order an item that does not exist (expect 400)
POST {{LogiTrack_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "customerName": "Acme Logistics",
  "items": [
    {
      "itemId": "00000000-0000-0000-0000-000000000000",
      "quantity": 1
    }
  ]
}

### Log in as the configured administrator to run delete examples below
# Replace these values with Authentication:Admin:Email and
# Authentication:Admin:Password from User Secrets or your secure configuration.
# @name adminLogin
POST {{LogiTrack_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "ReplaceWithAdminPassword123!"
}

### Delete the created order (requires administrator; expect 204)
DELETE {{LogiTrack_HostAddress}}/api/orders/{{createOrder.response.body.$.orderId}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### Delete the created item after deleting the order (requires administrator; expect 204)
DELETE {{LogiTrack_HostAddress}}/api/items/{{createInventoryItem.response.body.$.itemId}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
